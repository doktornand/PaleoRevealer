{
  "_schema_version": "2.1.0",
  "_description": "Règles hiérarchiques fusionnées : Architecture SCADA originale + Correctifs critiques Gemini",
  "rule_engine": {
    "priority_levels": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
    "matching_strategy": "hierarchical_cascade",
    "conflict_resolution": "priority_override",
    "cascade_order": [
      "critical_fixes",
      "data_string_rules",
      "architecture_rules",
      "format_rules",
      "register_rules",
      "interrupt_rules",
      "domain_rules",
      "pattern_rules",
      "instruction_rules",
      "segment_rules",
      "directive_rules",
      "macro_rules",
      "fallback_rules"
    ]
  },

  "critical_fixes": {
    "_priority": "CRITICAL",
    "apply_first": true,
    "rules": [
      {
        "id": "prevent_recursive_main",
        "match_pattern": "main PROC|END main|invoke ExitProcess.*0",
        "action": { "type": "singleton_guard", "module": "MasmGenerator", "method": "build" },
        "description": "Empêche la duplication du squelette main PROC/ENDP lors du pipeline"
      },
      {
        "id": "psp_to_getcommandline",
        "match_pattern": "mov si, 80h|mov cl, \\[si\\]|rep movsb",
        "action": { "type": "block_replacement", "module": "CommandLineParser", "method": "generateWin32Parser" },
        "description": "Remplace le parsing PSP DOS par GetCommandLineA Win32"
      }
    ]
  },

  "data_string_rules": {
    "_priority": "CRITICAL",
    "_description": "Parseur robuste des déclarations .data (chaînes, terminateurs)",
    "rules": [
      {
        "id": "fix_string_termination",
        "match_pattern": "DB\\s+.*'(?!.*',0)",
        "action": { "type": "parse_and_terminate", "module": "StringParser", "method": "convertToWin32" },
        "description": "Ferme les chaînes tronquées et remplace le terminateur DOS $ par ,0"
      },
      {
        "id": "ensure_null_terminated",
        "match_pattern": "DB\\s+[^,]+(?<!,0)$",
        "action": { "type": "append_null_terminator", "module": "StringParser", "method": "convertToWin32" },
        "description": "Sécurité: ajoute ,0 si absent en fin de déclaration"
      }
    ]
  },

  "architecture_rules": {
    "_priority": "HIGH",
    "_description": "Règles fondamentales de changement d'architecture",
    "rules": [
      {
        "id": "arch_x86_16_to_32",
        "name": "Passage 16-bit vers 32-bit",
        "condition": { "source_arch": "x86_16", "target_arch": "x86_32" },
        "transformations": {
          "memory_model": { "source": ".MODEL SMALL|MEDIUM|LARGE|HUGE", "target": ".MODEL FLAT, STDCALL" },
          "stack_operations": { "PUSHF": "PUSHFD", "POPF": "POPFD", "PUSHA": "PUSHAD", "POPA": "POPAD" }
        },
        "side_effects": [
          "Les offsets de segment (CS:, DS:, ES:, SS:) deviennent des labels ou sont ignorés en mode FLAT",
          "Les far calls/jumps nécessitent une réécriture manuelle"
        ]
      }
    ]
  },

  "format_rules": {
    "_priority": "HIGH",
    "_description": "Règles de conversion des formats exécutables",
    "rules": [
      {
        "id": "format_com_to_pe",
        "name": "Conversion .COM vers PE",
        "condition": { "source_format": "COM", "target_format": "PE" },
        "transformations": {
          "entry_point": {
            "setup_code": [".386", ".MODEL FLAT, STDCALL", "OPTION CASEMAP:NONE"]
          },
          "memory_layout": {
            "psp_simulation": "Supprimé : remplacé par GetCommandLineA",
            "stack_setup": "Gérée par le loader PE (1MB réservé par défaut)"
          }
        }
      },
      {
        "id": "format_mz_to_pe",
        "name": "Conversion .EXE (MZ) vers PE",
        "condition": { "source_format": "MZ", "target_format": "PE" },
        "transformations": {
          "segments_to_sections": {
            "mapping": {
              "CODE segment": ".text",
              "DATA segment": ".data",
              "BSS segment": ".bss"
            }
          }
        }
      }
    ]
  },

  "register_rules": {
    "_priority": "HIGH",
    "_description": "Règles de conversion des registres 16-bit vers 32-bit",
    "rules": [
      {
        "id": "reg_16_to_32",
        "name": "Expansion des registres généraux",
        "condition": { "register_size": 16, "target_size": 32 },
        "transformations": {
          "direct_mapping": { "AX": "EAX", "BX": "EBX", "CX": "ECX", "DX": "EDX", "SI": "ESI", "DI": "EDI", "BP": "EBP", "SP": "ESP" },
          "segment_registers": { "CS/DS/ES/SS": "Ignorés en mode FLAT", "strategy": "Utiliser des registres généraux ou des variables mémoire" }
        },
        "action": { "type": "expand_to_32bit", "module": "RegisterMapper", "method": "mapInstruction" }
      }
    ]
  },

  "interrupt_rules": {
    "_priority": "MEDIUM",
    "_description": "Règles de conversion des interruptions DOS/BIOS",
    "rules": [
      {
        "id": "int_21h_console",
        "name": "INT 21h - Affichage console (AH=09h) & Terminaison (AH=4Ch)",
        "condition": { "interrupt": "21h", "ah_value": "09|4C" },
        "transformations": {
          "09h_to_writeconsole": {
            "win32": "WriteConsoleA avec lstrlen dynamique",
            "action": { "module": "InterruptEmulator", "method": "dispatch", "params": { "ahValue": "09", "label": "auto_extract" } }
          },
          "4Ch_to_exitprocess": {
            "win32": "ExitProcess",
            "action": { "module": "InterruptEmulator", "method": "dispatch", "params": { "ahValue": "4C", "exitCode": 0 } }
          }
        }
      },
      {
        "id": "int_21h_file_ops",
        "name": "INT 21h - Opérations fichiers (AH=3Ch-46h)",
        "condition": { "interrupt": "21h", "ah_range": "3Ch-46h" },
        "transformations": {
          "create_file_3Ch": { "win32": "CreateFileA(..., CREATE_ALWAYS, ...)" },
          "open_file_3Dh": { "win32": "CreateFileA(..., OPEN_EXISTING, ...)" },
          "read_file_3Fh": { "win32": "ReadFile(handle, buffer, count, &bytesRead, NULL)" },
          "write_file_40h": { "win32": "WriteFile(handle, buffer, count, &bytesWritten, NULL)" },
          "close_file_3Eh": { "win32": "CloseHandle(handle)" }
        }
      },
      {
        "id": "int_10h_video",
        "name": "INT 10h - Services vidéo BIOS",
        "condition": { "interrupt": "10h" },
        "transformations": {
          "write_char_0Eh": { "win32": "WriteConsoleA(hConsole, &char, 1, &written, NULL)" },
          "set_cursor_02h": { "win32": "SetConsoleCursorPosition(hConsole, coord)" }
        }
      }
    ]
  },

  "domain_rules": {
    "_priority": "HIGH",
    "_description": "Règles spécifiques au domaine SCADA/IoT",
    "rules": [
      {
        "id": "domain_scada_iot",
        "name": "Patterns SCADA et IoT",
        "condition": { "domain": "SCADA", "sub_domain": "IoT_MAINTENANCE" },
        "transformations": {
          "serial_communication": {
            "legacy_ports": { "3F8h": "CreateFileA(\\\\.\\COM1)", "2F8h": "CreateFileA(\\\\.\\COM2)" },
            "api_mapping": { "IN port": "ReadFile", "OUT port": "WriteFile", "set_params": "SetCommState" }
          },
          "timing_and_polling": {
            "dos_timer": "INT 08h (18.2Hz)",
            "win32_replacement": "timeSetEvent ou CreateTimerQueueTimer"
          }
        }
      }
    ]
  },

  "pattern_rules": {
    "_priority": "MEDIUM",
    "_description": "Détection et transformation de patterns complexes",
    "rules": [
      {
        "id": "pattern_far_calls",
        "name": "Résolution des far calls",
        "condition": { "instruction": "CALLF|JMPF|RETF", "has_segment_change": true },
        "transformations": { "strategy": "Convertir en CALL NEAR ou créer une table de dispatch" }
      },
      {
        "id": "pattern_bcd_arithmetic",
        "name": "Émulation des instructions BCD",
        "condition": { "instructions": ["AAA", "AAS", "AAM", "AAD", "DAA", "DAS"] },
        "transformations": { "general_strategy": "Remplacer par des macros MASM ou routines C inline" }
      },
      {
        "id": "pattern_interrupt_hooks",
        "name": "Hooks d'interruption (INT 21h AH=25h/35h)",
        "condition": { "function": "SET_INTERRUPT_VECTOR|GET_INTERRUPT_VECTOR" },
        "transformations": { "win32_equivalent": "Vectored Exception Handling (VEH) ou SEH" }
      }
    ]
  },

  "instruction_rules": {
    "_priority": "LOW",
    "_description": "Conversion instruction par instruction",
    "rules": [
      {
        "id": "inst_string_ops",
        "name": "Opérations sur chaînes (MOVS, STOS, LODS, SCAS, CMPS)",
        "condition": { "prefix": "F2|F3", "opcode": "A4|A5|A6|A7|AA|AB|AC|AD|AE|AF" },
        "transformations": { "size_prefixes": { "16_bit_prefix": "66h (automatic if operand-size=16)" } }
      }
    ]
  },

  "segment_rules": {
    "_priority": "MEDIUM",
    "_description": "Conversion des segments et modèles mémoire",
    "rules": [
      {
        "id": "seg_model_conversion",
        "name": "Conversion des modèles mémoire",
        "condition": { "has_model_directive": true },
        "transformations": {
          "small_model": { "description": "Code et données dans un seul segment", "target": ".MODEL FLAT, STDCALL" },
          "large_model": { "description": "Multiple segments", "target": ".MODEL FLAT, STDCALL", "strategy": "Modules séparés avec PUBLIC/EXTERN" }
        }
      }
    ]
  },

  "directive_rules": {
    "_priority": "LOW",
    "_description": "Conversion des directives assembleur",
    "rules": [
      {
        "id": "dir_cpu_upgrade",
        "name": "Mise à niveau des directives CPU",
        "condition": { "directive": ".8086|.186|.286|.286P" },
        "transformations": { "mapping": { ".8086": ".386", ".186": ".386", ".286": ".386", ".286P": ".386P" } }
      },
      {
        "id": "remove_segment_init",
        "name": "Suppression initialisation segments DOS",
        "match_pattern": "mov ax, @DATA|mov ds, ax|mov es, ax",
        "action": { "type": "delete_line" },
        "description": "Initialisation implicite en mode FLAT Win32"
      }
    ]
  },

  "macro_rules": {
    "_priority": "LOW",
    "_description": "Macros et templates de structure",
    "rules": [
      {
        "id": "macro_win32_stubs",
        "name": "Macros de stub Win32",
        "condition": { "target_platform": "Win32" },
        "templates": {
          "program_skeleton": {
            "code": [".386", ".MODEL FLAT, STDCALL", "OPTION CASEMAP:NONE", "INCLUDE kernel32.inc", "INCLUDELIB kernel32.lib", "STD_OUTPUT_HANDLE EQU -11"],
            "enforcement": "single_pass_injection_only"
          }
        }
      }
    ]
  },

  "fallback_rules": {
    "_priority": "INFO",
    "_description": "Règles de secours et marquage pour intervention manuelle",
    "rules": [
      {
        "id": "fallback_unsupported",
        "name": "Instructions non supportées",
        "condition": { "match": "no_rule_applied" },
        "action": { "type": "MARK_MANUAL", "marker": "MANUAL_REVIEW_REQUIRED", "output": "; [PALEOREVEALER] Instruction non convertie automatiquement. Intervention manuelle requise." }
      }
    ]
  }
}